# Copied to .env by `make up`, which fills the three secrets with random values. Nothing here is a real credential.
# The admin user's password for the controller (user: admin).
ADMIN_PASSWORD=
# The token the publish step presents to the artifact store; the store expects the same value.
PUBLISH_TOKEN=
# Host ports (loopback only).
CONTROLLER_PORT=18481
GIT_PORT=18480
SINK_PORT=18482
